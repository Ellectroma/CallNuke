[node name="ScrollContainer" type="ScrollContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ListContainer" type="VBoxContainer" parent="Margin/Root/ScrollContainer"]

[connection signal="pressed" from="Margin/Root/HeaderRow/BackButton" to="." method="_on_back_pressed"]
[connection signal="text_submitted" from="Margin/Root/AddRow/KeywordInput" to="." method="_on_keyword_submitted"]
[connection signal="pressed" from="Margin/Root/AddRow/AddButton" to="." method="_on_add_pressed"]
